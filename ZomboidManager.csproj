<Project Sdk="Microsoft.NET.Sdk">

  <!-- Identity / Windows file version metadata (visible in EXE Properties) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\ZMIcon.ico</ApplicationIcon>

    <AssemblyName>ZomboidManager</AssemblyName>
    <AssemblyTitle>Project Zomboid Dedicated Server Management Tool</AssemblyTitle>
    <Product>Zomboid Manager</Product>
    <Company>Vusco</Company>
    <Authors>Vusco</Authors>
    <Description>Project Zomboid Dedicated Server Management Tool</Description>
    <Copyright>© 2026 Vusco</Copyright>
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <InformationalVersion>1.0.8</InformationalVersion>
  </PropertyGroup>

  <!--
    Release publish defaults: self-contained single-file win-x64 EXE.
    No .NET runtime required on the target machine. Signing is done externally
    (SignPath / Azure Trusted Signing) after publish — not in this project.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreRCON" Version="5.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI is embedded so auto-update only needs to replace the EXE. -->
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>ui/wwwroot/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Dev convenience: keep wwwroot next to the build output when debugging. -->
    <None Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <Content Include="Assets\ZMIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
